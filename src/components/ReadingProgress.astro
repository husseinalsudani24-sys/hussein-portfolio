{/* Bound by initReadingProgress() in animations.ts — a no-op if this
    element isn't present on the page, so it's safe to only drop this
    into long-form pages (case studies) rather than every page. */}
<div class="reading-progress" aria-hidden="true">
  <span class="reading-progress-bar"></span>
</div>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 1000;
    background: transparent;
  }

  .reading-progress-bar {
    display: block;
    width: 100%;
    height: 100%;
    transform: scaleX(0);
    transform-origin: left;
    background: linear-gradient(90deg, var(--primary), #06b6d4);
  }

  :global([dir="rtl"]) .reading-progress-bar {
    transform-origin: right;
  }
</style>
