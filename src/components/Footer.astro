---
import { getRelativeLocaleUrl } from "astro:i18n";
import SocialLinks from "./SocialLinks.astro";
import Portrait from "./Portrait.astro";
import { portfolio } from "../data/portfolio";
import { getTranslations, defaultLocale, type Locale } from "../i18n";

const { personal } = portfolio;
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = getTranslations(locale);
const home = getRelativeLocaleUrl(locale, "");
const projectsUrl = getRelativeLocaleUrl(locale, "projects");
const year = new Date().getFullYear();
---

<footer class="footer">

  <div class="container footer-cta">
    <h3>{t.footer.ctaHeading}</h3>
    <a href={`mailto:${personal.email}`} class="btn">{t.footer.ctaButton}</a>
  </div>

  <div class="container footer-content">

    <div class="footer-brand">

      <div class="footer-brand-row">
        <Portrait size="44px" glow={false} />

        <div>
          <h3>Hussein Al Sudani</h3>

          <p>
            {t.footer.tagline}
          </p>
        </div>
      </div>

      <div class="footer-socials">
        <SocialLinks iconSize={18} buttonSize={38} />
      </div>

    </div>

    <div class="footer-links">

      <a href={`${home}#about`}>{t.footer.linkAbout}</a>

      <a href={projectsUrl}>{t.footer.linkProjects}</a>

      <a href={`${home}#skills`}>{t.footer.linkSkills}</a>

      <a href={`${home}#contact`}>{t.footer.linkContact}</a>

    </div>

    <div class="footer-contact">

      <a href={`mailto:${personal.email}`}>{personal.email}</a>

      <a href={`tel:${personal.phone}`}>{personal.phone}</a>

      <span>{t.caseStudy.dubaiUae}</span>

    </div>

  </div>

  <div class="copyright">

    © {year} Hussein Al Sudani. {t.footer.rightsReserved}

  </div>

</footer>

<style>

.footer{

padding:0 0 30px;

border-top:1px solid var(--border);

background:var(--bg);

}

.footer-cta{

display:flex;

justify-content:space-between;

align-items:center;

flex-wrap:wrap;

gap:24px;

padding:56px 0;

border-bottom:1px solid var(--border);

}

.footer-cta h3{

font-size:clamp(1.4rem,3vw,1.8rem);

}

.footer-content{

padding-top:56px;

display:flex;

justify-content:space-between;

align-items:flex-start;

gap:40px;

flex-wrap:wrap;

}

.footer-brand-row{

display:flex;

align-items:center;

gap:14px;

margin-bottom:4px;

}

.footer-links,
.footer-contact{

display:flex;

flex-direction:column;

gap:14px;

}

.footer-links{

flex-direction:row;

flex-wrap:wrap;

gap:24px;

align-self:center;

}

.footer-links a,
.footer-contact a{

color:var(--muted);

text-decoration:none;

transition:.3s;

}

.footer-contact span{

color:var(--muted);

}

.footer-links a:hover,
.footer-contact a:hover{

color:var(--primary);

}

.footer-socials{

display:flex;

gap:12px;

margin-top:18px;

}

.copyright{

margin-top:50px;

text-align:center;

color:#6f6f80;

font-size:.9rem;

}

@media(max-width:768px){

.footer-cta,
.footer-content{

flex-direction:column;

text-align:center;

}

.footer-links{

justify-content:center;

}

.footer-brand-row{

justify-content:center;

}

.footer-socials{

justify-content:center;

}

}

</style>
