---
import { ArrowRight } from "@lucide/astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getTranslations, defaultLocale, type Locale } from "../i18n";

interface Props {
  slug: string;
  category: string;
  title: string;
  description: string;
  tags: string[];
  gradient: string;
  image?: string;
}

const { slug, category, title, description, tags, gradient, image } = Astro.props;
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = getTranslations(locale);
const href = getRelativeLocaleUrl(locale, `projects/${slug}`);
---

<article class="project-card">
  <a
    href={href}
    class="card-link"
    aria-label={`View case study: ${title}`}
  >
    <div class="project-thumb" style={{ background: gradient }}>
      {image && (
        <img
          src={image}
          alt={title}
          class="thumb-image"
          loading="lazy"
          decoding="async"
          width="800"
          height="380"
        />
      )}
      <span class="thumb-tag" aria-hidden="true">{category}</span>
    </div>

    <div class="card-body">
      <h3>{title}</h3>
      <p>{description}</p>

      <div class="tech">
        {tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>

      <span class="card-cta">
        {t.projectCard.viewCaseStudy}
        <ArrowRight size={16} stroke-width={2.5} aria-hidden="true" />
      </span>
    </div>
  </a>
</article>

<style>
  /* Base surface, hover lift and gradient-ring glow are inherited from the
     shared .project-card rules in global.css — only card-specific layout
     overrides (no padding, clipped thumbnail) live here. */

  .project-card {
    padding: 0;
    overflow: hidden;
  }

  .card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .project-thumb {
    position: relative;
    height: 200px;
    display: flex;
    align-items: flex-end;
    padding: 20px;
    transition: transform 0.5s ease;
    overflow: hidden;
  }

  .thumb-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .project-thumb::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 30% 20%, rgba(255, 255, 255, 0.25), transparent 55%),
      linear-gradient(180deg, transparent 40%, rgba(0, 0, 0, 0.25));
    pointer-events: none;
  }

  .project-card:hover .project-thumb {
    transform: scale(1.04);
  }

  .thumb-tag {
    position: relative;
    z-index: 1;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(8, 8, 13, 0.4);
    backdrop-filter: blur(8px) saturate(160%);
    -webkit-backdrop-filter: blur(8px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: white;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .card-body {
    padding: 28px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-body h3 {
    margin-bottom: 12px;
    font-size: 1.3rem;
  }

  .card-body p {
    flex: 1;
  }

  .tech {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin: 22px 0 24px;
  }

  .tech span {
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    font-size: 0.78rem;
    color: var(--muted);
  }

  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--primary);
    font-weight: 700;
    transition: gap 0.3s;
  }

  .card-cta svg {
    transition: transform 0.3s;
  }

  .project-card:hover .card-cta {
    gap: 12px;
  }

  .project-card:hover .card-cta svg {
    transform: translateX(2px);
  }

  :global([dir="rtl"]) .card-cta svg {
    transform: scaleX(-1);
  }

  :global([dir="rtl"]) .project-card:hover .card-cta svg {
    transform: scaleX(-1) translateX(2px);
  }
</style>
