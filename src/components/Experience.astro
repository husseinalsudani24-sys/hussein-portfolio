---
import { getTranslations, defaultLocale, type Locale } from "../i18n";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = getTranslations(locale);

const jobs = t.experience.jobs;
---

<section id="experience" class="section" data-reveal>

  <div class="container">

    <span class="section-tag">
      {t.experience.tag}
    </span>

    <h2>
      {t.experience.heading}
    </h2>

    <div class="timeline">

      {jobs.map((job) => (
        <div class="timeline-item">

          <div class="timeline-dot"></div>

          <div class="timeline-content">

            <span class="timeline-date">
              {job.date}
            </span>

            <h3>
              {job.title}
            </h3>

            <span class="timeline-company">{job.company}</span>

            <ul class="timeline-points">
              {job.points.map((point) => <li>{point}</li>)}
            </ul>

          </div>

        </div>
      ))}

    </div>

  </div>

</section>

<style>

.timeline{
    position:relative;
    max-width:900px;
    margin:auto;
    --timeline-progress:0;
}

.timeline::before{
    content:"";
    position:absolute;
    left:16px;
    top:0;
    bottom:0;
    width:2px;
    background:var(--border);
}

/* Draws in as the section scrolls past — see initTimelineDraw in
   animations.ts, which tweens --timeline-progress via ScrollTrigger scrub.
   A real GSAP-animatable custom property, layered over the static line
   above, rather than trying to animate a pseudo-element directly (GSAP
   can't target ::before/::after as tween targets). */
.timeline::after{
    content:"";
    position:absolute;
    left:16px;
    top:0;
    bottom:0;
    width:2px;
    background:linear-gradient(var(--primary), var(--primary-glow));
    transform-origin:top;
    transform:scaleY(var(--timeline-progress));
}

.timeline-item{
    position:relative;
    padding-left:60px;
    margin-bottom:50px;
}

.timeline-item:last-child{
    margin-bottom:0;
}

.timeline-dot{
    position:absolute;
    left:8px;
    top:8px;
    width:18px;
    height:18px;
    border-radius:50%;
    background:var(--primary);
}

.timeline-date{
    display:inline-block;
    color:var(--primary);
    font-size:.9rem;
    font-weight:700;
    margin-bottom:8px;
}

.timeline-company{
    display:block;
    color:var(--muted);
    font-weight:600;
    margin:6px 0 16px;
}

.timeline-points{
    display:flex;
    flex-direction:column;
    gap:10px;
    list-style:none;
}

.timeline-points li{
    position:relative;
    padding-left:20px;
    color:var(--muted);
}

.timeline-points li::before{
    content:"";
    position:absolute;
    left:0;
    top:.6em;
    width:6px;
    height:6px;
    border-radius:50%;
    background:var(--primary);
}

@media(max-width:480px){

.timeline-item{
padding-left:44px;
margin-bottom:36px;
}

.timeline-content{
padding:22px;
}

}

:global([dir="rtl"]) .timeline::before,
:global([dir="rtl"]) .timeline::after{
    left:auto;
    right:16px;
}

:global([dir="rtl"]) .timeline-item{
    padding-left:0;
    padding-right:60px;
}

:global([dir="rtl"]) .timeline-dot{
    left:auto;
    right:8px;
}

:global([dir="rtl"]) .timeline-points li{
    padding-left:0;
    padding-right:20px;
}

:global([dir="rtl"]) .timeline-points li::before{
    left:auto;
    right:0;
}

@media(max-width:480px){

:global([dir="rtl"]) .timeline-item{
padding-left:0;
padding-right:44px;
}

}

</style>
