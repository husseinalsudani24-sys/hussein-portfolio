---
import { portfolio } from "../data/portfolio";

interface Props {
  /** Any valid CSS width/height value, e.g. "140px" or "min(300px,58vw)". */
  size?: string;
  glow?: boolean;
  eager?: boolean;
  class?: string;
}

const { size = "120px", glow = true, eager = false, class: className = "" } = Astro.props;
const { personal } = portfolio;
---

<div class={`portrait-frame ${glow ? "portrait-glow" : ""} ${className}`} style={`--portrait-size:${size};`}>
  <img
    src={personal.photo}
    alt={`Portrait of ${personal.name}`}
    class="portrait-img"
    loading={eager ? "eager" : "lazy"}
    decoding="async"
  />
</div>

<style>
  .portrait-frame {
    position: relative;
    width: var(--portrait-size);
    height: var(--portrait-size);
    flex-shrink: 0;
    border-radius: 50%;
    padding: 4px;
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.6), rgba(79, 70, 229, 0.05));
    box-shadow: var(--shadow-premium);
  }

  .portrait-glow {
    box-shadow: 0 0 clamp(20px, 6vw, 60px) rgba(139, 92, 246, 0.4), var(--shadow-premium);
  }

  .portrait-img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    background: var(--surface);
    border: 3px solid var(--bg);
  }
</style>
