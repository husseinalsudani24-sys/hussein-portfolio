---
import Portrait from "./Portrait.astro";
import { getTranslations, defaultLocale, type Locale } from "../i18n";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = getTranslations(locale);
---

<section id="about" class="section" data-reveal>
  <div class="container about">

    <div class="about-left">
      <Portrait size="130px" class="about-portrait" />

      <span class="section-tag">{t.about.tag}</span>

      <h2>{t.about.heading}</h2>

      <p>
        {t.about.paragraph1}
      </p>

      <p>
        {t.about.paragraph2}
      </p>
    </div>

    <div class="about-right">

      <div class="stat-card">
        <h3>4+</h3>
        <span>{t.about.statYearsLabel}</span>
      </div>

      <div class="stat-card">
        <h3>SEO</h3>
        <span>{t.about.statSeoLabel}</span>
      </div>

    </div>

  </div>
</section>

<style>
.about{
    display:grid;
    grid-template-columns:1.2fr 1fr;
    gap:70px;
    align-items:center;
}

.about-left :global(.about-portrait){
    margin-bottom:24px;
}

.about-right{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:22px;
}

.stat-card h3{
    font-size:2rem;
    margin-bottom:10px;
}

.stat-card span{
    color:var(--muted);
}

@media (max-width:900px){

.about{
grid-template-columns:1fr;
}

.about-left{
text-align:center;
}

.about-left :global(.about-portrait){
margin-inline:auto;
}

.about-right{
grid-template-columns:1fr 1fr;
}

}
</style>
