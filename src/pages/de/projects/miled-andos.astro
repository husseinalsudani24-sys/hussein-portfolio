---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navbar from "../../../components/Navbar.astro";
import Footer from "../../../components/Footer.astro";
import ReadingProgress from "../../../components/ReadingProgress.astro";
import { ArrowLeft } from "@lucide/astro";
import { portfolio } from "../../../data/portfolio";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getTranslations, defaultLocale, type Locale } from "../../../i18n";

const project = portfolio.projects.find((p) => p.slug === "miled-andos")!;
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = getTranslations(locale);
const c = t.caseStudies["miled-andos"];
const category = t.projectsData["miled-andos"].category;
const pagePath = "/projects/miled-andos";
const projectsHref = getRelativeLocaleUrl(locale, "projects");

// Numbers are exactly as stated in the CV: clicks +127%, impressions
// +212%, #1 rankings for core brand keywords, top-10 for two named
// local search terms. Nothing beyond that is claimed.

const heroStats = [
  { value: "127", suffix: "%" },
  { value: "212", suffix: "%" },
];
---

<BaseLayout
  title={`${c.metaTitle} | ${portfolio.personal.name}`}
  description={c.metaDescription}
  path={pagePath}
>
  <ReadingProgress />
  <Navbar path={pagePath} />

  <main id="main-content">
    <section class="section case-hero">
      <div class="case-hero-bg" aria-hidden="true"></div>

      <div class="container case-hero-wrapper">
        <a href={projectsHref} class="back-link">
          <ArrowLeft size={16} stroke-width={2.5} aria-hidden="true" />
          {t.caseStudy.backToProjects}
        </a>

        <span class="tag-badge">{category} &bull; {t.caseStudy.caseStudyBadge}</span>

        <h1>{project.title}</h1>

        <p class="lead">
          {c.lead}
        </p>

        <dl class="hero-meta">
          <div>
            <dt>{t.caseStudy.roleLabel}</dt>
            <dd>{c.roleValue}</dd>
          </div>
          <div>
            <dt>{t.caseStudy.clientLabel}</dt>
            <dd>{project.title}</dd>
          </div>
          <div>
            <dt>{t.caseStudy.locationLabel}</dt>
            <dd>{t.caseStudy.dubaiUae}</dd>
          </div>
          <div>
            <dt>{t.caseStudy.durationLabel}</dt>
            <dd>{c.durationValue}</dd>
          </div>
        </dl>

        <div class="stat-grid" data-reveal>
          {heroStats.map((stat, i) => (
            <div class="stat-card">
              <h3 class="count-up" data-count-to={stat.value} data-suffix={stat.suffix}>0</h3>
              <span>{c.heroStats[i].label}</span>
            </div>
          ))}
          <div class="stat-card">
            <h3>{c.keywordRankingsExtraStat.value}</h3>
            <span>{c.keywordRankingsExtraStat.label}</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section" data-reveal>
      <div class="container">
        <span class="section-tag">{t.caseStudy.overviewTag}</span>
        <h2>{c.overviewHeading}</h2>
        <p class="section-intro">
          {c.overviewText}
        </p>
      </div>
    </section>

    <section class="section" data-reveal>
      <div class="container">
        <span class="section-tag">{t.caseStudy.responsibilitiesTag}</span>
        <h2>{c.responsibilitiesHeading}</h2>
        <ul class="role-list">
          {c.responsibilities.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" data-reveal>
      <div class="container">
        <span class="section-tag">{c.rankingsTag}</span>
        <h2>{c.rankingsHeading}</h2>
        <div class="card-grid">
          {c.rankings.map((item) => (
            <article class="info-card">
              <h3>{item.keyword}</h3>
              <p>{item.position}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" data-reveal>
      <div class="container">
        <span class="section-tag">{t.caseStudy.toolsTag}</span>
        <h2>{t.caseStudy.whatWasUsedHeading}</h2>
        <div class="tech-grid">
          {c.tools.map((tool) => (
            <span class="tech-pill">{tool}</span>
          ))}
        </div>
      </div>
    </section>

    <section class="section" data-reveal>
      <div class="container">
        <span class="section-tag">{t.caseStudy.galleryTag}</span>
        <h2>{t.caseStudy.galleryHeading}</h2>
        <p class="section-intro">
          {c.galleryIntro}
        </p>
        <div class="gallery-grid">
          {c.gallery.map((item, i) => (
            <figure class="gallery-item">
              <div
                class="gallery-visual"
                style={{
                  background: i === 0
                    ? "linear-gradient(135deg,#06b6d4,#4f46e5)"
                    : "linear-gradient(135deg,#4f46e5,#06b6d4)",
                }}
                aria-hidden="true"
              ></div>
              <figcaption>{item.label}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="section cta" data-reveal>
      <div class="container">
        <span class="section-tag">{t.caseStudy.nextStepTag}</span>
        <h2>{c.ctaHeading}</h2>
        <p>
          {c.ctaText}
        </p>
        <div class="cta-buttons">
          <a href={`mailto:${portfolio.personal.email}`} class="btn">{t.caseStudy.startConversation}</a>
          <a href={projectsHref} class="btn-outline">{t.caseStudy.viewMoreCaseStudies}</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  import { initPageAnimations } from "../../../scripts/animations";
  initPageAnimations();
</script>
