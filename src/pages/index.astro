---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import FeaturedCompanies from "../components/FeaturedCompanies.astro";
import About from "../components/About.astro";
import ResultsMetrics from "../components/ResultsMetrics.astro";
import Projects from "../components/Projects.astro";
import TechStack from "../components/TechStack.astro";
import Skills from "../components/Skills.astro";
import Experience from "../components/Experience.astro";
import Certifications from "../components/Certifications.astro";
import Testimonials from "../components/Testimonials.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import { getTranslations, defaultLocale, type Locale } from "../i18n";

const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = getTranslations(locale);
---

<BaseLayout
  title={t.meta.home.title}
  description={t.meta.home.description}
  path="/"
>
  <Navbar path="/" />
  <main id="main-content">
    <Hero />
    <FeaturedCompanies />
    <About />
    <ResultsMetrics />
    <Projects />
    <TechStack />
    <Skills />
    <Experience />
    <Certifications />
    <Testimonials />
    <Contact />
  </main>
  <Footer />
</BaseLayout>

<script>
  import { initPageAnimations } from "../scripts/animations";
  initPageAnimations();
</script>
